#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
readonly ROOT
case "${XDG_CACHE_HOME:-}" in
  /*) CACHE_HOME="$XDG_CACHE_HOME" ;;
  *) CACHE_HOME="$HOME/.cache" ;;
esac
readonly CACHE_HOME
mkdir -p -- "$CACHE_HOME/proof-crucible"
SCRATCH="$(mktemp -d "$CACHE_HOME/proof-crucible/campaign.XXXXXXXX")"
readonly SCRATCH
trap 'rm -rf -- "$SCRATCH"' EXIT

git -C "$SCRATCH" init -b main --quiet
git -C "$SCRATCH" config user.name 'Proof Crucible Check'
git -C "$SCRATCH" config user.email 'proof-crucible@example.invalid'
git -C "$SCRATCH" config commit.gpgsign false
git -C "$SCRATCH" -c protocol.file.allow=always submodule add --quiet "$ROOT" .crucible
"$SCRATCH/.crucible/bin/crucible" --repo "$SCRATCH" init --campaign template-check

# lean-action primes this checkout before the disposable campaign is created.
# Reuse those exact pinned packages rather than compiling Mathlib a second time.
if [[ -d "$ROOT/campaign-template/.lake/packages" ]]; then
  PACKAGE_POOL="$(readlink -f -- "$SCRATCH/.lake/packages")"
  readonly PACKAGE_POOL
  cp -al -- "$ROOT/campaign-template/.lake/packages/." "$PACKAGE_POOL/"
fi

git -C "$SCRATCH" add .
git -C "$SCRATCH" commit --quiet -m 'Initialize template check campaign'
"$SCRATCH/scripts/check.sh"
printf 'campaign-template: ok\n'
