#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
readonly ROOT
cd -- "$ROOT"

python3 -m py_compile bin/crucible tests/test_protocol.py
python3 -m unittest discover -s tests -v
python3 - <<'PY'
import json
from pathlib import Path

root = Path.cwd()
schema = json.loads((root / "protocol/1/event.schema.json").read_text())
assert schema["$defs"]["obligation"]["properties"]["protocol"]["const"] == 1

skill = (root / ".agents/skills/proof-crucible/SKILL.md").read_text()
assert skill.startswith("---\nname: proof-crucible\ndescription:")
assert "protocol/1/PROTOCOL.md" in skill

link = root / "campaign-template/.agents/skills/proof-crucible"
assert link.is_symlink()
assert str(link.readlink()) == "../../.crucible/.agents/skills/proof-crucible"
PY
bin/crucible --help >/dev/null

if git diff --check --quiet; then
  printf 'check: ok\n'
else
  git diff --check
  exit 1
fi

